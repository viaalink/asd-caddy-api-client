# Caddy with the caddy-l4 (layer4) plugin: TCP routing for the SQL inspection tests
# caddy-l4 is pinned to the commit the library's types are generated from (DEPENDENCIES.md):
# upstream master at the merge of the remote_ip_list reload fix (mholt/caddy-l4#492).
FROM caddy:2.11-builder AS builder

RUN xcaddy build \
    --with github.com/mholt/caddy-l4@e54f24a1a59b099d22778ed423935cde56d83d4b

FROM caddy:2.11-alpine

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
