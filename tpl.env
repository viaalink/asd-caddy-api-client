# tpl.env — the MITMproxy demo's per-checkout settings (read by via.yaml).
# `via env init` / `via env sync` resolve the macros into .env once and keep
# them: every clone or worktree gets its own ports and container names, so
# several copies of the demo run side by side without blocking each other.

COMPOSE_PROJECT_NAME=getRandomString(length=6,charset=hex,prefix='caddy-mitm-')

# Host ports, one band per service (only the demo Caddy is needed to use it;
# the rest are published for poking around).
DEMO_HTTP_PORT=getRandomPort(min=39000,max=39199)
DEMO_ADMIN_PORT=getRandomPort(min=39200,max=39399)
DEMO_API_PORT=getRandomPort(min=39400,max=39599)
DEMO_ES_PORT=getRandomPort(min=39600,max=39799)
DEMO_MITM_PROXY_PORT=getRandomPort(min=39800,max=39899)
DEMO_MITM_WEB_PORT=getRandomPort(min=39900,max=39999)
DEMO_MITM_NODE_PROXY_PORT=getRandomPort(min=38800,max=38899)
DEMO_MITM_NODE_WEB_PORT=getRandomPort(min=38900,max=38999)

# Public subdomain when shared with `via run share` (unique per clone).
DEMO_SUBDOMAIN=${COMPOSE_PROJECT_NAME}
